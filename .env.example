# Copy this file to github.env (or any name) and fill in the token.
# Pass it with: update-craft update all --env-file github.env
#
# GITHUB_TOKEN is read only from the --env-file. A fine-grained token with
# "Public repositories (read-only)" access is enough; without it GitHub
# limits requests to 60 per hour.
GITHUB_TOKEN=github_pat_your_token_here

# TYPESAFE_API_KEY is required for the safety check. A value here overrides
# the environment variable of the same name.
TYPESAFE_API_KEY=your-typesafe-key-here

# CRAFT_ROOT is NOT read from this file. Set it in the environment instead:
#   setx CRAFT_ROOT "C:\Users\you\Documents\GitHub"
