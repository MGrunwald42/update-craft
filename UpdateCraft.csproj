<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>update-craft</AssemblyName>
    <RootNamespace>UpdateCraft</RootNamespace>
    <Version>0.1.0</Version>
    <Product>update-craft</Product>
    <Description>Safety-checked updater, builder and launcher for the Craft apps</Description>
    <Authors>Martin Grunwald</Authors>
    <Copyright>Copyright (c) 2026 Martin Grunwald</Copyright>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- The keypad plugin is its own project (built against the Logi Plugin API); keep its sources out of this one. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);keypad-plugin/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shipped next to the exe: MIT requires these notices to travel with copies of the binary. -->
    <None Include="LICENSE;THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

</Project>
